rules_version = '2';
// 매출 보고 클라우드 보관함 보안 규칙 (Firebase 콘솔 → Firestore → 규칙에 붙여 넣기)
//
// 매장 자료는 boards/{열쇠}/ 아래에 둡니다. 열쇠 = 긴 무작위 글자 (docs/SETUP.md ①-6)
//   보는 폰 (로그인 없음)   → 설치 주소 /b/{열쇠}/ 를 아는 폰만 읽음 (열쇠를 모르면 목록도 못 봄). 쓰기 없음
//   사무실 PC (C)           → senders/{이메일} = { board: "{열쇠}" } 계정으로 로그인해
//                             보고(reports) · 날씨(weather) · 상태(devices)만 씀
//   senders 문서는 Firebase 콘솔에서만 만듦
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth != null && request.auth.token.email != null ? request.auth.token.email.lower() : "";
    }
    function isSender(board) {
      return email() != ""
        && exists(/databases/$(database)/documents/senders/$(email()))
        && get(/databases/$(database)/documents/senders/$(email())).data.board == board;
    }

    match /boards/{board} {
      // 그날 보고 (C 가 카페 · 키즈 · 네이버 조각을 합친 것) — 문서 이름 = 날짜, report = JSON 글자
      match /reports/{date} {
        allow read: if true;
        allow write: if isSender(board)
          && date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.date == date
          && request.resource.data.report is string
          && request.resource.data.report.size() < 900000;
      }

      // 날씨 (기상청 관측 · 오늘 예보) — 문서 이름 = 날짜
      match /weather/{date} {
        allow read: if true;
        allow write: if isSender(board)
          && date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.date == date;
      }

      // C 상태 (devices/office)
      match /devices/{id} {
        allow read: if true;
        allow write: if isSender(board);
      }
    }

    // C 계정 명단 — 자기 문서만 읽기, 쓰기는 콘솔에서만
    match /senders/{em} {
      allow read: if email() == em;
    }
  }
}
