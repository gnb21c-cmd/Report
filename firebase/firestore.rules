rules_version = '2';
// 매출 보고 클라우드 보관함 보안 규칙 (Firebase 콘솔 → Firestore → 규칙에 붙여 넣기 · 또는 GitHub Deploy 가 저절로)
//
// 매장 자료는 boards/{열쇠}/ 아래에 둡니다. 열쇠 = 긴 무작위 글자 (docs/SETUP.md ③)
//   보는 폰 (B, 로그인 없음) → 설치 주소 /b/{열쇠}/ 를 아는 폰만 보고(reports) · 날씨(weather)를 읽음. 쓰기 없음
//   베이커리 매니저 (D) · 현장 태블릿 (D-1, 주소 /d1/{키 번호}/ — 매장 열쇠가 아님, 생산 수량 복사본만 읽음. 매니저가 번호를 바꾸면 예전 번호는 막힘)
//   입력 계정 (A 직원 · 날씨 · 베이커리 매니저) → senders/{이메일} = { board: "{열쇠}" } 명단에 있는 계정만 씀
//   senders 문서는 Firebase 콘솔에서만 만듦 (A 는 로그인 때 자기 문서에서 열쇠를 읽음)
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth != null && request.auth.token.email != null ? request.auth.token.email.lower() : "";
    }
    function isSender(board) {
      return email() != ""
        && exists(/databases/$(database)/documents/senders/$(email()))
        && get(/databases/$(database)/documents/senders/$(email())).data.board == board;
    }
    // 운영자 — senders/{이메일} 문서에 admin: true (Firebase 콘솔에서만 넣음). 태블릿 키 번호를 바꿀 수 있음
    function isAdmin(board) {
      return isSender(board) && get(/databases/$(database)/documents/senders/$(email())).data.get("admin", false) == true;
    }
    function piece(name) {
      return !(name in request.resource.data) || (request.resource.data[name] is string && request.resource.data[name].size() < 900000);
    }

    match /boards/{board} {
      // 그날 보고 — 칸 cafe · kids · naver · cash(자금) · extra(자판기 · 네컷 · 주차) = 조각 JSON (A 가 보낸 칸만 바뀜)
      match /reports/{date} {
        allow read: if true;
        allow write: if isSender(board)
          && date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.date == date
          && request.resource.data.keys().hasOnly(["date", "at", "cafe", "kids", "naver", "cash", "extra"])
          && piece("cafe") && piece("kids") && piece("naver") && piece("cash") && piece("extra");
      }

      // 오늘 마감 전 영업정보 — 칸 cafe · kids(OKPOS) · naver(네이버 예약현황 장수) = 조각 JSON (POS 메인 PC 가 매시 15분 · 45분, packages/core/src/live.ts). 보는 폰은 reports 처럼 읽기만
      match /live/{date} {
        allow read: if true;
        allow write: if isSender(board)
          && date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.date == date
          && request.resource.data.keys().hasOnly(["date", "at", "cafe", "kids", "naver"])
          && piece("cafe") && piece("kids") && piece("naver");
      }

      // 날씨 (기상청 관측 · 오늘 예보) — 문서 이름 = 날짜. GitHub 날씨 계정이 씀
      match /weather/{date} {
        allow read: if true;
        allow write: if isSender(board)
          && date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.date == date;
      }

      // 보고 설정 (기간 스티커 · 휴일 더하기/빼기) — 보는 폰도 읽음, 입력 계정만 씀
      match /settings/{doc} {
        allow read: if true;
        allow write: if isSender(board) && piece("json");
      }

      // 통합데스크 설문 보고함 (2026-10-15) — 키즈 POS 통합데스크가 로그인 없이 매일 20:00(뒤에 숫자가 바뀌면 다시) 씀 · 보고 앱은 읽기만
      //   문서 이름 = 설문 기간 시작일, json = 통합데스크 보고 파일(report-outbox\survey-날짜.json)과 같은 글 (손님 정보 없음, docs/SURVEY.md)
      //   이 매장 열쇠를 아는 곳만(보고 설정이 있는 매장) · 설문 보고 모양 · 크기만 · 지우기는 입력 계정만
      match /surveyInbox/{from} {
        allow read: if true;
        allow create, update: if from.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && exists(/databases/$(database)/documents/boards/$(board)/settings/main)
          && request.resource.data.keys().hasOnly(["json", "at"])
          && request.resource.data.json is string && request.resource.data.json.size() < 20000
          && request.resource.data.json.matches("(?s)^[{].*astanakiz-survey.*$")
          && request.resource.data.at is string && request.resource.data.at.size() < 40;
        allow delete: if isSender(board);
      }

      // 키즈 실시간 (2026-10-16) — 키즈 POS 통합데스크가 1분마다 · 바뀌면 바로 지금 현황을 씀 → B '입장권 판매 총 수량' → 키즈 실시간 (docs/KIDS_LIVE.md)
      //   문서 하나(now)만 계속 덮어씀 · json = 통합데스크 현황 글(astanakiz-live). 열쇠를 가진 손님 이름 · 전화 포함(열쇠 미반납 때 관리자 전화 — 사장님 지시)이라 지난 기록은 안 쌓음
      //   이 매장 열쇠를 아는 곳만(보고 설정이 있는 매장) · 현황 모양 · 크기만 · 지우기는 입력 계정만
      match /deskLive/{doc} {
        allow read: if true;
        allow create, update: if doc == "now"
          && exists(/databases/$(database)/documents/boards/$(board)/settings/main)
          && request.resource.data.keys().hasOnly(["json", "at"])
          && request.resource.data.json is string && request.resource.data.json.size() < 100000
          && request.resource.data.json.matches("(?s)^[{].*astanakiz-live.*$")
          && request.resource.data.at is string && request.resource.data.at.size() < 40;
        allow delete: if isSender(board);
      }

      // 재방문 간격 (2026-10-19 사장님 · 통합데스크 → B '네이버 판매 수' 세부 화면 맨 위) — astanakiz docs/REVISIT.md · docs/KIDS_REVISIT.md
      //   문서 하나(revisit)만 매일 20:00 덮어씀 · json = 일수 모음(astanakiz-revisit) · 손님 정보 없음
      match /deskStats/{doc} {
        allow read: if true;
        allow create, update: if doc == "revisit"
          && exists(/databases/$(database)/documents/boards/$(board)/settings/main)
          && request.resource.data.keys().hasOnly(["json", "at"])
          && request.resource.data.json is string && request.resource.data.json.size() < 20000
          && request.resource.data.json.matches("(?s)^[{].*astanakiz-revisit.*$")
          && request.resource.data.at is string && request.resource.data.at.size() < 40;
        allow delete: if isSender(board);
      }

      // 베이커리 작업지시 — 계획(plans: 매일 16시 GitHub 가 씀) · 확정(orders: 매니저 D 가 씀). 현장 태블릿 D-1 · 보고 앱 B 는 읽기만
      match /plans/{date} {
        allow read: if true;
        allow write: if isSender(board)
          && date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.date == date
          && request.resource.data.keys().hasOnly(["date", "at", "json"])
          && piece("json");
      }
      match /orders/{date} {
        allow read: if true;
        allow write: if isSender(board)
          && date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.date == date
          && request.resource.data.keys().hasOnly(["date", "at", "json"])
          && piece("json");
      }

      // 상품 분류표 · 정리한 영수증 줄 — 입력 계정만 (폰은 안 읽음)
      // 상품 분류표 등 — 입력 계정. 단 태블릿 키 번호(config/floor)는 운영자만 씀
      // 네이버 [신규 다시 확인] 요청(config/naverAsk)은 정해진 계정만 (packages/core/src/naverAuto.ts NAVER_ASK_EMAIL)
      match /config/{doc} {
        allow read: if isSender(board);
        allow write: if isSender(board) && (doc != "floor" || isAdmin(board)) && (doc != "naverAsk" || email() == "mssong@alphavision.co.kr");
      }
      match /lines/{id} {
        allow read, write: if isSender(board);
      }
    }

    // 현장 태블릿 (D-1) — 매장 열쇠 대신 키 번호. floor/{키 번호} = { board, active } 는 매니저 앱 [태블릿 주소]에서 만들고 바꿈
    //   days/{날짜} = 빵 이름 · 수량 · 상태 복사본만 (매출 · 예상 손님 없음) → 태블릿 주소를 받은 직원은 이것만 봄
    match /floor/{fk} {
      allow create: if isAdmin(request.resource.data.board) && request.resource.data.keys().hasOnly(["board", "at", "active"]);
      // 키 번호를 바꾸면 예전 번호는 active = false (같은 매장 운영자만)
      allow update: if isAdmin(resource.data.board)
        && request.resource.data.board == resource.data.board
        && request.resource.data.keys().hasOnly(["board", "at", "active"]);
      match /days/{date} {
        allow read: if get(/databases/$(database)/documents/floor/$(fk)).data.active == true;
        allow write: if isSender(get(/databases/$(database)/documents/floor/$(fk)).data.board)
          && date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.date == date
          && request.resource.data.keys().hasOnly(["date", "at", "json"])
          && piece("json");
      }
    }

    // 입력 계정 명단 — 자기 문서만 읽기, 쓰기는 콘솔에서만
    match /senders/{em} {
      allow read: if email() == em;
    }
  }
}
